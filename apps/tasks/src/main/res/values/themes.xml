<resources>
    <!-- Only what Android shows before Compose draws: the window and splash screen, following light or dark. -->
    <style name="Theme.Range" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_icon_background</item>
    </style>
</resources>
